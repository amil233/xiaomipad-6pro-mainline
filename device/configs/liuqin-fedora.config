# Fedora 用 SELinux 管理权限。arm64 的默认配置里只有 AppArmor，SELinux 根本
# 没有编进内核（CONFIG_SECURITY_SELINUX 未设置），Fedora 的 systemd、服务
# 和命令行工具都假定它存在，所以这里打开。
#
# 先用 permissive：策略照常加载，违规只记日志不拦截。等桌面和硬件都正常了
# 再收紧，别让标签不全挡住第一次启动。
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_AVC_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_SELINUX_SID2STR_CACHE_SIZE=256

# 默认安全模块换成 SELinux，并把它放进启动时启用的模块列表。列表里的其它
# 名字沿用当前配置，不因为换发行版去动它们。
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,ipe,bpf"
