#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

case ${1:-} in
start|stop) ;;
*) echo 'Usage: liuqin-slpi start|stop' >&2; exit 2 ;;
esac

for remote in /sys/class/remoteproc/remoteproc*; do
    [ "$(cat "$remote/name")" = slpi ] || continue
    if [ "$1" = start ]; then
        # 这一批镜像里 registry 可能还没从 persist 导入；缺了只警告，不拦启动。
        if runuser -u fastrpc -- test -r /var/lib/liuqin-sensors/sensors/registry/SHA256SUMS; then
            echo 'SLPI startup: registry present'
        else
            echo 'SLPI startup: warning: registry not imported yet'
        fi
        state=$(cat "$remote/state")
        [ "$state" != running ] || exit 0
        [ "$state" = offline ] || exit 1
        echo start > "$remote/state"
    else
        [ "$(cat "$remote/state")" != offline ] || exit 0
        echo stop > "$remote/state"
    fi
    exit 0
done

echo 'SLPI remote processor is unavailable' >&2
exit 1
