[Unit]
Description=liuqin SLPI FastRPC reverse tunnel
# 节点要等 liuqin-slpi 把 SLPI 拉起来才出现，所以必须先启动它；否则
# ConditionPathExists 在开机时判为不满足，整个服务被跳过（事实如此）。
Requires=liuqin-slpi.service
After=systemd-udevd.service systemd-tmpfiles-setup.service liuqin-slpi.service
ConditionPathExists=/dev/fastrpc-sdsp
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
# udev 规则之外再兜一层：节点权限不对时，用 root 身份先把组和权限改好，
# 再切到 fastrpc。+ 前缀表示这一行不以 User= 的身份执行。
ExecStartPre=+/usr/bin/chgrp fastrpc /dev/fastrpc-sdsp
ExecStartPre=+/usr/bin/chmod 0660 /dev/fastrpc-sdsp
User=fastrpc
Group=fastrpc
# -R 必须写死。不写的时候 daemon 会按设备树的 model/compatible 猜目录：
# 本机是 model="Xiaomi Pad 6 Pro"、compatible="xiaomi,liuqin","qcom,sm8475"，
# 于是它去找 /usr/share/qcom/sm8475/Xiaomi/liuqin，而树在 sm8450 下（原厂
# vendor 分区的命名）。猜不到就退回默认前缀 /usr/share/qcom/，那里没有
# sensors/ 目录，固件读不到 registry，一个传感器都不会注册。Ubuntu 线一直是
# 写死这条路径的。
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s -R /usr/share/qcom/sm8450/Xiaomi/liuqin
# The patched daemon maps every listener teardown to a non-zero process exit.
# Retry transient FastRPC loss, but fail closed after three rapid crashes.
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_LOCAL
ReadOnlyPaths=/usr/share/qcom/sm8450/Xiaomi/liuqin
# 固件会在 registry 旁边写 temp.json，所以 /var 这一侧必须可写。
ReadWritePaths=/var/lib/liuqin-sensors
DevicePolicy=closed
DeviceAllow=/dev/fastrpc-sdsp rw

[Install]
WantedBy=liuqin-sensor-stack.target
