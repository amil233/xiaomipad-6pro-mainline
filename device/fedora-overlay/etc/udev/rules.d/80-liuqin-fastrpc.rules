# fastrpc 的字符设备由 misc_register() 注册（drivers/misc/fastrpc.c:2468-2473），
# 名字是 "fastrpc-<domain>" 或 "fastrpc-<domain>-secure"，所以 udev 里
# SUBSYSTEM 是 misc、KERNEL 是 fastrpc-*。内核不设权限，默认 root:root 0600，
# 而 hexagonrpcd 以 fastrpc 用户运行，需要显式交出来。
SUBSYSTEM=="misc", KERNEL=="fastrpc-*", GROUP="fastrpc", MODE="0660"
